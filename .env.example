# Same names as kaderisasi-web-be (copy from ../env/dev/web-be-dev-env).
NODE_ENV=development
HOST=127.0.0.1
PORT=3333
LOG_LEVEL=info
TZ=Asia/Jakarta
APP_KEY=
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_DATABASE=
# Optional; defaults to public.
DB_SCHEMA=
# S3-compatible storage (same as web-be).
DRIVE_DISK=minio
DRIVE_ENDPOINT=
DRIVE_REGION=
DRIVE_BUCKET=
DRIVE_ACCESS_KEY_ID=
DRIVE_SECRET_ACCESS_KEY=
# Password recovery email (same as web-be).
RESET_PASSWORD_URL=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
# Google sign-in (optional; POST /v2/auth/google answers 503 without them).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Extra OAuth callbacks other first-party apps may use, comma separated (e.g. https://perintis.salmanitb.com/masuk/google).
GOOGLE_EXTRA_REDIRECT_URIS=

# Optional, local demos/tests only: shift the Perintis programme clock (RFC 3339). Never set in production.
PERINTIS_CLOCK=
