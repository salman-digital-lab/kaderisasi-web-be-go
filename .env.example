# Same names as kaderisasi-web-be (copy from ../env/dev/web-be-dev-env).
NODE_ENV=development
HOST=127.0.0.1
PORT=3333
LOG_LEVEL=info
TZ=Asia/Jakarta
APP_KEY=
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_DATABASE=
# Optional; defaults to public.
DB_SCHEMA=
# Password recovery email (same as web-be).
RESET_PASSWORD_URL=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
# Google sign-in (optional; POST /v2/auth/google answers 503 without them).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Adonis web-be origin for routes not ported yet (no path).
WEB_BE_LEGACY_URL=http://localhost:3335
